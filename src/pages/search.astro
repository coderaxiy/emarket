---
import ComingSoon from '@/components/ComingSoon.astro';
import { createT, getLocale } from '@/i18n';
import Layout from '@/layouts/Layout.astro';

const t = createT(getLocale(Astro.cookies));
const query = Astro.url.searchParams.get('q')?.trim() ?? '';
---

<Layout title={t('placeholder.searchTitle')} noindex={query !== ''}>
  <ComingSoon
    title={t('placeholder.searchTitle')}
    subtitle={query ? t('placeholder.searchResultsFor', { query }) : undefined}
  />
</Layout>
