---
import { BanknoteIcon, CheckIcon, CircleCheckIcon, ClockIcon, MapPinIcon, PackageIcon, PhoneIcon, UserIcon } from 'lucide-react';
import { CancelGroupButton } from '@/components/react/CancelGroupButton';
import { Badge } from '@/components/ui/badge';
import { ErrorState } from '@/components/ui/state';
import { createT, getLocale, INTL_LOCALES, type TranslationKey } from '@/i18n';
import Layout from '@/layouts/Layout.astro';
import { fetchOrder, fetchPickupStatus } from '@/lib/api/ordersServer';
import type { PaymentMethod, PickupHoldingItemStatus, PickupStatusRead } from '@/lib/api/types';
import { loginUrl } from '@/lib/auth';
import { formatDate, formatMoney } from '@/lib/format';
import { canCancelGroup, GROUP_STEPS, groupProgress, groupStatus, isAtPickupPoint, ORDER_STATUS, orderItemCount } from '@/lib/orders';
import { addressLandmark, formatAddress } from '@/lib/pickupPoints';

// One order: the confirmation right after checkout (`?placed=1`) and, later, the order
// detail page. Login required (PROTECTED_PATHS). Someone else's order is a 404.
const locale = getLocale(Astro.cookies);
const t = createT(locale);
const intlLocale = INTL_LOCALES[locale];

const orderId = Number(Astro.params.id);
if (!Number.isInteger(orderId) || orderId <= 0) return Astro.rewrite('/404');

const result = await fetchOrder(orderId, Astro.request.headers.get('cookie'));
if (result.status === 'notFound') return Astro.rewrite('/404');
if (result.status === 'unauthorized') return Astro.redirect(loginUrl(`${Astro.url.pathname}${Astro.url.search}`));
const order = result.status === 'ok' ? result.order : undefined;
const justPlaced = Astro.url.searchParams.get('placed') === '1';

const PAYMENT: Record<PaymentMethod, TranslationKey> = {
  cash_on_delivery: 'checkout.cashAtPoint',
  payme: 'order.paymentPayme',
  click: 'order.paymentClick',
  uzcard: 'order.paymentUzcard',
};

const status = order ? ORDER_STATUS[order.status] : undefined;
const itemCount = order ? orderItemCount(order) : 0;

// Pickup status (deadline, per-item state) only exists once a group is at the point.
const cookie = Astro.request.headers.get('cookie');
const pickupStatuses = new Map<number, PickupStatusRead>();
if (order) {
  const atPoint = order.groups.filter(isAtPickupPoint);
  const statuses = await Promise.all(atPoint.map((group) => fetchPickupStatus(order.id, group.id, cookie)));
  atPoint.forEach((group, index) => {
    const pickup = statuses[index];
    if (pickup) pickupStatuses.set(group.id, pickup);
  });
}
const ITEM_STATUS: Record<PickupHoldingItemStatus, TranslationKey> = {
  holding: 'order.itemWaiting',
  collected: 'order.itemCollected',
  rejected_by_buyer: 'order.itemDeclined',
  expired_uncollected: 'order.itemExpired',
};
const point = order?.pickup_point ?? null;
const retryHref = `${Astro.url.pathname}${Astro.url.search}`;
const card = 'flex flex-col gap-3 rounded-xl border border-border bg-card p-4 sm:p-5';
const cardTitle = 'flex items-center gap-2 text-lg font-semibold [&_svg]:size-5 [&_svg]:text-accent';
---

<Layout title={order ? t('order.title', { number: order.order_number }) : t('nav.orders')} noindex>
  <section class="mx-auto flex max-w-4xl flex-col gap-5 px-4 py-6 sm:py-8">
    {
      order ? (
        <>
          {justPlaced && (
            <div class="relative isolate flex flex-col items-start gap-3 overflow-hidden rounded-xl bg-success/12 p-5 sm:flex-row sm:items-center sm:p-6">
              <CircleCheckIcon className="size-10 shrink-0 text-success" aria-hidden="true" />
              <div class="flex flex-col gap-1">
                <h2 class="font-display text-xl font-semibold tracking-tight">{t('order.placedTitle')}</h2>
                <p class="text-sm text-pretty text-muted-foreground">{t('order.placedBody')}</p>
              </div>
            </div>
          )}

          <header class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-col gap-1">
              <h1 class="font-display text-2xl font-semibold tracking-tight tabular-nums sm:text-3xl">
                {t('order.title', { number: order.order_number })}
              </h1>
              {order.placed_at && (
                <p class="text-sm text-muted-foreground">
                  {t('order.placedAt', { date: formatDate(order.placed_at, intlLocale, { dateStyle: 'long', timeStyle: 'short' }) })}
                </p>
              )}
            </div>
            <Badge variant={status?.tone ?? 'neutral'} className="px-3 py-1 text-sm">
              {status ? t(status.label) : order.status}
            </Badge>
          </header>

          <div class="grid gap-4 md:grid-cols-2">
            {point && (
              <section class={card}>
                <h2 class={cardTitle}>
                  <MapPinIcon aria-hidden="true" />
                  {t('checkout.pickupPoint')}
                </h2>
                <div class="flex flex-col gap-1 text-sm">
                  <p class="text-base font-medium">{point.name}</p>
                  {formatAddress(point.address) && <p class="text-muted-foreground">{formatAddress(point.address)}</p>}
                  {addressLandmark(point.address) && <p class="text-xs text-muted-foreground">{addressLandmark(point.address)}</p>}
                  {point.contact_phone && (
                    <p class="mt-1 inline-flex items-center gap-1 text-muted-foreground tabular-nums">
                      <PhoneIcon className="size-3.5" aria-hidden="true" />
                      <a href={`tel:${point.contact_phone.replace(/[^\d+]/g, '')}`} class="hover:text-foreground hover:underline">
                        {point.contact_phone}
                      </a>
                    </p>
                  )}
                </div>
              </section>
            )}

            <section class={card}>
              <h2 class={cardTitle}>
                <UserIcon aria-hidden="true" />
                {t('checkout.recipient')}
              </h2>
              <div class="flex flex-col gap-1 text-sm">
                <p class="text-base font-medium">{order.recipient.full_name}</p>
                <p class="text-muted-foreground tabular-nums">{order.recipient.phone}</p>
                {order.recipient.notes && <p class="text-muted-foreground">{order.recipient.notes}</p>}
              </div>
            </section>
          </div>

          {order.groups.map((group, index) => {
            const groupState = groupStatus(group.status);
            const progress = groupProgress(group);
            const pickup = pickupStatuses.get(group.id);
            const itemState = new Map(pickup?.items.map((item) => [item.order_line_id, item]) ?? []);
            return (
              <section class={card} aria-labelledby={`group-${group.id}`}>
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h2 id={`group-${group.id}`} class={cardTitle}>
                    <PackageIcon aria-hidden="true" />
                    {order.groups.length > 1 ? t('order.shipmentOf', { index: index + 1, total: order.groups.length }) : t('order.shipment')}
                  </h2>
                  <Badge variant={groupState.tone}>{t(groupState.label)}</Badge>
                </div>

                {progress !== undefined && (
                  <ol class="grid grid-cols-6 gap-1" aria-label={t('order.progress')}>
                    {GROUP_STEPS.map((step, stepIndex) => {
                      const done = stepIndex < progress;
                      const current = stepIndex === progress;
                      return (
                        <li class="flex flex-col gap-1.5" aria-current={current ? 'step' : undefined}>
                          <span class:list={['h-1.5 rounded-full', done ? 'bg-success' : current ? 'bg-accent' : 'bg-muted']} />
                          <span class:list={['hidden text-xs sm:block', done || current ? 'text-foreground' : 'text-muted-foreground']}>
                            {done && <CheckIcon className="mr-0.5 inline size-3 text-success" aria-hidden="true" />}
                            {t(step)}
                          </span>
                          <span class="sr-only sm:hidden">
                            {t(step)}: {done ? t('order.stepDone') : current ? t('order.stepCurrent') : t('order.stepUpcoming')}
                          </span>
                        </li>
                      );
                    })}
                  </ol>
                )}

                {pickup && (
                  <p class="flex items-start gap-2 rounded-lg bg-success/12 px-3 py-2 text-sm">
                    <ClockIcon className="mt-0.5 size-4 shrink-0 text-success" aria-hidden="true" />
                    <span>
                      {t('order.readyUntil', {
                        date: formatDate(pickup.collection_deadline, intlLocale, { dateStyle: 'long', timeStyle: 'short' }),
                      })}
                    </span>
                  </p>
                )}
                {group.status === 'cancelled' && group.cancellation_reason && (
                  <p class="text-sm text-muted-foreground">{t('order.cancelReason', { reason: group.cancellation_reason })}</p>
                )}

                <ul class="divide-y divide-border">
                  {group.lines.map((line) => {
                    const held = itemState.get(line.id);
                    return (
                      <li class="flex items-start justify-between gap-4 py-3 text-sm">
                        <span class="flex min-w-0 flex-col gap-0.5">
                          <span>{line.product_title_snapshot}</span>
                          <span class="text-muted-foreground tabular-nums">
                            {line.quantity} × {formatMoney(line.unit_price, intlLocale)}
                          </span>
                          {held && <span class="text-xs text-muted-foreground">{t(ITEM_STATUS[held.status])}</span>}
                        </span>
                        <span class="shrink-0 font-semibold tabular-nums">{formatMoney(line.line_total, intlLocale)}</span>
                      </li>
                    );
                  })}
                </ul>

                {canCancelGroup(group) && (
                  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border pt-3">
                    <p class="text-xs text-muted-foreground">{t('cancel.hint')}</p>
                    <CancelGroupButton client:visible locale={locale} orderId={order.id} groupId={group.id} />
                  </div>
                )}
              </section>
            );
          })}

          <section class={card}>
            <dl class="flex flex-col gap-2 text-sm">
              <div class="flex items-center justify-between gap-4">
                <dt class="text-muted-foreground">{t('cart.itemCount', { count: itemCount })}</dt>
              </div>
              <div class="flex items-center justify-between gap-4">
                <dt class="inline-flex items-center gap-2 text-muted-foreground">
                  <BanknoteIcon className="size-4" aria-hidden="true" />
                  {t(PAYMENT[order.payment_method])}
                </dt>
              </div>
              <div class="flex items-baseline justify-between gap-4 border-t border-border pt-3">
                <dt class="font-semibold">{t('order.total')}</dt>
                <dd class="text-2xl font-semibold text-primary tabular-nums">{formatMoney(order.total_amount, intlLocale)}</dd>
              </div>
            </dl>
          </section>

          {order.payment_method === 'cash_on_delivery' && (
            <p class="flex items-start gap-2 text-sm text-muted-foreground">
              <ClockIcon className="mt-0.5 size-4 shrink-0" aria-hidden="true" />
              {t('order.cashNote')}
            </p>
          )}

          <div class="flex flex-wrap gap-3">
            <a
              href="/catalog"
              class="inline-flex h-11 items-center rounded-full bg-accent px-6 font-medium text-accent-foreground hover:bg-accent/90 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none"
            >
              {t('order.continueShopping')}
            </a>
            <a
              href="/orders"
              class="inline-flex h-11 items-center rounded-full border border-border bg-card px-6 font-medium hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
            >
              {t('header.myOrders')}
            </a>
          </div>
        </>
      ) : (
        <ErrorState title={t('state.loadFailed')}>
          <a
            slot="action"
            href={retryHref}
            class="inline-flex h-10 items-center rounded-full border border-border bg-card px-5 text-sm font-medium hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
          >
            {t('common.retry')}
          </a>
        </ErrorState>
      )
    }
  </section>
</Layout>
