---
import CatalogResults from '@/components/CatalogResults.astro';
import CategoryTiles from '@/components/CategoryTiles.astro';
import { createT, getLocale } from '@/i18n';
import Layout from '@/layouts/Layout.astro';
import { CatalogRequestError, fetchCategoryTree, fetchProducts } from '@/lib/api/catalogServer';
import { filtersFromUrl, nonEmptyCategories } from '@/lib/catalog';

// Every visible product, with the top-level categories above the grid.
const locale = getLocale(Astro.cookies);
const t = createT(locale);
const filters = filtersFromUrl(Astro.url.searchParams);

const [treeResult, productsResult] = await Promise.allSettled([fetchCategoryTree(), fetchProducts(filters)]);
// Without the tree the page still works: the grid is the main content.
const roots = treeResult.status === 'fulfilled' ? nonEmptyCategories(treeResult.value) : [];
const result =
  productsResult.status === 'fulfilled'
    ? productsResult.value
    : productsResult.reason instanceof CatalogRequestError
      ? productsResult.reason
      : new CatalogRequestError(0);
---

<Layout title={t('nav.catalog')}>
  <CatalogResults
    title={t('nav.catalog')}
    filters={filters}
    basePath="/catalog"
    result={result}
    emptyTitle={t('catalog.emptyTitle')}
    emptyBody={t('catalog.emptyBody')}
  >
    {
      roots.length > 0 && filters.page === 1 && (
        <CategoryTiles categories={roots} label={t('catalog.categories')} />
      )
    }
  </CatalogResults>
</Layout>
