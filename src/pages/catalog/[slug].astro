---
import { ChevronRightIcon } from 'lucide-react';
import CatalogResults from '@/components/CatalogResults.astro';
import { ErrorState } from '@/components/ui/state';
import { createT, getLocale, pickTranslation } from '@/i18n';
import Layout from '@/layouts/Layout.astro';
import { CatalogRequestError, fetchCategoryTree, fetchProducts, type ProductPage } from '@/lib/api/catalogServer';
import { categoryName, filtersFromUrl, findCategory, nonEmptyCategories } from '@/lib/catalog';

// A category page. The slug is resolved from the cached tree (category slugs are
// globally unique); the grid includes every descendant category.
const locale = getLocale(Astro.cookies);
const t = createT(locale);
const slug = Astro.params.slug ?? '';

let tree;
try {
  tree = await fetchCategoryTree();
} catch {
  tree = undefined;
}

const found = tree ? findCategory(tree, slug) : undefined;
if (tree && !found) return Astro.rewrite('/404');

let result: ProductPage | CatalogRequestError | undefined;
const filters = { ...filtersFromUrl(Astro.url.searchParams), categoryId: found?.category.id };
if (found) {
  try {
    result = await fetchProducts(filters);
  } catch (error) {
    // The category left the public tree after we cached it.
    if (error instanceof CatalogRequestError && error.status === 404) return Astro.rewrite('/404');
    result = error instanceof CatalogRequestError ? error : new CatalogRequestError(0);
  }
}

const name = found ? categoryName(found.category, locale) : '';
const description = found ? (pickTranslation(found.category.translations, locale)?.description ?? undefined) : undefined;
const children = found ? nonEmptyCategories(found.category.children) : [];
const ancestors = found ? found.path.slice(0, -1) : [];
const retryHref = `${Astro.url.pathname}${Astro.url.search}`;
---

<Layout title={name || t('nav.catalog')} description={description}>
  {
    found && result ? (
      <CatalogResults
        title={name}
        filters={filters}
        basePath={`/catalog/${encodeURIComponent(found.category.slug)}`}
        result={result}
        emptyTitle={t('catalog.emptyTitle')}
        emptyBody={t('catalog.emptyBody')}
      >
        <nav slot="breadcrumbs" aria-label={t('catalog.breadcrumbs')}>
          <ol class="flex flex-wrap items-center gap-1 text-sm text-muted-foreground">
            <li>
              <a href="/catalog" class="hover:text-foreground hover:underline">
                {t('nav.catalog')}
              </a>
            </li>
            {ancestors.map((ancestor) => (
              <li class="flex items-center gap-1">
                <ChevronRightIcon className="size-3.5" aria-hidden="true" />
                <a href={`/catalog/${encodeURIComponent(ancestor.slug)}`} class="hover:text-foreground hover:underline">
                  {categoryName(ancestor, locale)}
                </a>
              </li>
            ))}
          </ol>
        </nav>

        {children.length > 0 && filters.page === 1 && (
          <nav aria-label={t('catalog.subcategories')}>
            <ul class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0">
              {children.map((child) => (
                <li class="shrink-0">
                  <a
                    href={`/catalog/${encodeURIComponent(child.slug)}`}
                    class="inline-flex h-9 items-center rounded-full bg-secondary px-4 text-sm font-medium text-secondary-foreground transition-colors hover:bg-accent/15 hover:text-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
                  >
                    {categoryName(child, locale)}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </CatalogResults>
    ) : (
      <section class="mx-auto max-w-7xl px-4 py-8">
        <ErrorState title={t('state.loadFailed')}>
          <a
            slot="action"
            href={retryHref}
            class="inline-flex h-10 items-center rounded-full border border-border bg-card px-5 text-sm font-medium hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
          >
            {t('common.retry')}
          </a>
        </ErrorState>
      </section>
    )
  }
</Layout>
