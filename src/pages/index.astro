---
import { ArrowRightIcon, MapPinIcon, ShoppingBasketIcon, WalletIcon } from 'lucide-react';
import CategoryTiles from '@/components/CategoryTiles.astro';
import ProductRail from '@/components/ProductRail.astro';
import { createT, getLocale, type TranslationKey } from '@/i18n';
import Layout from '@/layouts/Layout.astro';
import { fetchCategoryTree, fetchProducts } from '@/lib/api/catalogServer';
import type { CategoryNodeRead, ProductCardRead } from '@/lib/api/types';
import { categoryName, filtersFromUrl, nonEmptyCategories } from '@/lib/catalog';

const locale = getLocale(Astro.cookies);
const t = createT(locale);

// Real catalog data only: newest products overall and in the biggest categories. Any
// failed call just leaves its section out; the editorial parts always render.
const CATEGORY_RAILS = 3;
const noFilters = filtersFromUrl(new URLSearchParams());
const newest = { ...noFilters, sort: 'newest' as const };
const roots: CategoryNodeRead[] = await fetchCategoryTree().then(nonEmptyCategories, () => []);
const railCategories = [...roots].sort((a, b) => b.product_count - a.product_count).slice(0, CATEGORY_RAILS);
const [latest, ...byCategory] = await Promise.allSettled([
  fetchProducts(newest),
  ...railCategories.map((category) => fetchProducts({ ...newest, categoryId: category.id })),
]);
const RAIL_SIZE = 12;
/** A category row with fewer products than this (after de-duplication) isn't worth showing. */
const MIN_RAIL_ITEMS = 4;
const items = (result: PromiseSettledResult<{ items: ProductCardRead[] }> | undefined) =>
  result?.status === 'fulfilled' ? result.value.items : [];
const newArrivals = items(latest).slice(0, RAIL_SIZE);

// With a small catalog the category rows would repeat "New arrivals": skip products
// already shown above, and drop rows that end up too short.
const shown = new Set(newArrivals.slice(0, 6).map((product) => product.id));
const categoryRails = railCategories
  .map((category, index) => {
    const products = items(byCategory[index]).filter((product) => !shown.has(product.id)).slice(0, RAIL_SIZE);
    products.slice(0, 6).forEach((product) => shown.add(product.id));
    return { category, products };
  })
  .filter((rail) => rail.products.length >= MIN_RAIL_ITEMS);

// Editorial copy only — no fake promos, discounts or product rails without an endpoint.
const STEPS: { icon: typeof MapPinIcon; title: TranslationKey; body: TranslationKey }[] = [
  { icon: ShoppingBasketIcon, title: 'home.step1Title', body: 'home.step1Body' },
  { icon: MapPinIcon, title: 'home.step2Title', body: 'home.step2Body' },
  { icon: WalletIcon, title: 'home.step3Title', body: 'home.step3Body' },
];
---

<Layout>
  <section class="mx-auto max-w-7xl px-4 pt-4 sm:pt-8">
    <div class="relative isolate overflow-hidden rounded-xl bg-accent px-6 py-10 text-accent-foreground sm:px-12 sm:py-16">
      <div class="pattern-fade-left absolute inset-y-0 right-0 -z-10 w-2/3" aria-hidden="true">
        <div class="pattern-girih size-full opacity-50 [--color-accent:var(--accent-foreground)]"></div>
      </div>
      <div class="flex max-w-2xl flex-col gap-5">
        <h1 class="font-display text-3xl leading-tight font-semibold tracking-tight text-balance sm:text-5xl">
          {t('home.heroTitle')}
        </h1>
        <p class="max-w-xl text-base text-pretty opacity-90 sm:text-lg">{t('home.heroBody')}</p>
        <a
          href="/catalog"
          class="inline-flex h-12 w-fit items-center gap-2 rounded-full bg-primary px-6 font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-primary-foreground focus-visible:ring-offset-2 focus-visible:ring-offset-accent focus-visible:outline-none"
        >
          {t('home.heroCta')}
          <ArrowRightIcon className="size-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  {
    roots.length > 0 && (
      <section class="mx-auto flex max-w-7xl flex-col gap-4 px-4 pt-10 sm:pt-12">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="font-display text-xl font-semibold tracking-tight sm:text-2xl">{t('home.categoriesTitle')}</h2>
          <a href="/catalog" class="shrink-0 text-sm font-medium text-accent hover:underline">
            {t('product.seeAll')}
          </a>
        </div>
        <CategoryTiles categories={roots.slice(0, 12)} label={t('home.categoriesTitle')} />
      </section>
    )
  }

  <div class="mx-auto max-w-7xl px-4 pt-10 sm:pt-12">
    <ProductRail title={t('home.newArrivals')} href="/catalog?sort=newest" items={newArrivals} desktopRows={1} />
  </div>

  <section id="how-it-works" class="mx-auto max-w-7xl scroll-mt-24 px-4 py-12 sm:py-16">
    <h2 class="font-display text-xl font-semibold tracking-tight sm:text-2xl">{t('home.stepsTitle')}</h2>
    <ol class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        STEPS.map(({ icon: Icon, title, body }, index) => (
          <li class="flex flex-col gap-3 rounded-lg border border-border bg-card p-5">
            <div class="flex items-center gap-3">
              <span class="flex size-10 items-center justify-center rounded-full bg-primary/12 text-primary">
                <Icon className="size-5" aria-hidden="true" />
              </span>
              <span class="font-display text-sm font-semibold text-muted-foreground tabular-nums">0{index + 1}</span>
            </div>
            <h3 class="text-lg font-semibold">{t(title)}</h3>
            <p class="text-sm text-muted-foreground">{t(body)}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    categoryRails.length > 0 && (
      <div class="mx-auto flex max-w-7xl flex-col gap-10 px-4 pb-12 sm:pb-16">
        {categoryRails.map(({ category, products }) => (
          <ProductRail
            title={categoryName(category, locale)}
            href={`/catalog/${encodeURIComponent(category.slug)}`}
            items={products}
            desktopRows={1}
          />
        ))}
      </div>
    )
  }
</Layout>
