# Backend base URL, including the /api/v1 prefix.
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional — pickup-point map. A missing key shows an inline "map unavailable" state.
PUBLIC_YANDEX_MAPS_API_KEY=
PUBLIC_YANDEX_SUGGEST_API_KEY=

# Dev only. Serves fixtures from src/lib/api/fixtures/ for endpoints the backend
# doesn't have yet. Never enable in production.
PUBLIC_USE_FIXTURES=false
